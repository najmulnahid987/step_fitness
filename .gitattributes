# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Code and text configuration files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env* text eol=lf

# Assets and binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.keystore binary
*.jks binary
*.p8 binary
*.p12 binary
